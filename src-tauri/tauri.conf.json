{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Account Switcher",
  "version": "0.1.2",
  "identifier": "local.codexharbor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChatGPT Account Switcher",
        "width": 1160,
        "height": 790,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Manage and switch your Codex accounts",
    "longDescription": "An independent Windows companion for securely saving and switching Codex accounts, with encrypted local storage and signed app updates.",
    "category": "Utility",
    "publisher": "nickfouf",
    "copyright": "Copyright © 2026 nickfouf",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Greek",
          "German",
          "Spanish",
          "French",
          "Italian",
          "PortugueseBR",
          "Portuguese",
          "Dutch",
          "Swedish",
          "Danish",
          "Norwegian",
          "Finnish",
          "Polish",
          "Czech",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Ukrainian",
          "Russian",
          "Turkish",
          "Arabic",
          "Hebrew",
          "Farsi",
          "Hindi",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Indonesian",
          "Vietnamese",
          "Thai"
        ],
        "customLanguageFiles": {
          "English": "installer/languages/English.nsh",
          "Greek": "installer/languages/Greek.nsh",
          "German": "installer/languages/German.nsh",
          "Spanish": "installer/languages/Spanish.nsh",
          "French": "installer/languages/French.nsh",
          "Italian": "installer/languages/Italian.nsh",
          "PortugueseBR": "installer/languages/PortugueseBR.nsh",
          "Portuguese": "installer/languages/Portuguese.nsh",
          "Dutch": "installer/languages/Dutch.nsh",
          "Swedish": "installer/languages/Swedish.nsh",
          "Danish": "installer/languages/Danish.nsh",
          "Norwegian": "installer/languages/Norwegian.nsh",
          "Finnish": "installer/languages/Finnish.nsh",
          "Polish": "installer/languages/Polish.nsh",
          "Czech": "installer/languages/Czech.nsh",
          "Hungarian": "installer/languages/Hungarian.nsh",
          "Romanian": "installer/languages/Romanian.nsh",
          "Bulgarian": "installer/languages/Bulgarian.nsh",
          "Ukrainian": "installer/languages/Ukrainian.nsh",
          "Russian": "installer/languages/Russian.nsh",
          "Turkish": "installer/languages/Turkish.nsh",
          "Arabic": "installer/languages/Arabic.nsh",
          "Hebrew": "installer/languages/Hebrew.nsh",
          "Farsi": "installer/languages/Farsi.nsh",
          "Hindi": "installer/languages/Hindi.nsh",
          "SimpChinese": "installer/languages/SimpChinese.nsh",
          "TradChinese": "installer/languages/TradChinese.nsh",
          "Japanese": "installer/languages/Japanese.nsh",
          "Korean": "installer/languages/Korean.nsh",
          "Indonesian": "installer/languages/Indonesian.nsh",
          "Vietnamese": "installer/languages/Vietnamese.nsh",
          "Thai": "installer/languages/Thai.nsh"
        },
        "displayLanguageSelector": true,
        "startMenuFolder": "ChatGPT Account Switcher",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMDkxOUM3MDZFNzQ4MTYKUldRV1NPY0d4eGtKVEtPNFhkUVhoallWakpGSUtCbmRvVWhia0d6SkVsY0xRRFlydlZsUER2dTYK",
      "endpoints": [
        "https://github.com/nickfouf/ChatGPTAccountSwitcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
