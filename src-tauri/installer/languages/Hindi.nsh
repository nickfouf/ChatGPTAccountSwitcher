LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें या फिर से इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। कोई कार्रवाई चुनें और जारी रखने के लिए अगला पर क्लिक करें।"
LangString appRunning ${LANG_HINDI} "${PRODUCTNAME} चल रहा है। पहले इसे बंद करें, फिर दोबारा कोशिश करें।"
LangString appRunningOkKill ${LANG_HINDI} "${PRODUCTNAME} चल रहा है।$\nइसे बंद करने के लिए ठीक पर क्लिक करें।"
LangString chooseMaintenanceOption ${LANG_HINDI} "रखरखाव की कार्रवाई चुनें।"
LangString chooseHowToInstall ${LANG_HINDI} "चुनें कि ${PRODUCTNAME} कैसे इंस्टॉल करना है।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएँ"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (बिना अनइंस्टॉल किए पुराना संस्करण इंस्टॉल करना अक्षम है)"
LangString failedToKillApp ${LANG_HINDI} "${PRODUCTNAME} को बंद नहीं किया जा सका। पहले इसे बंद करें, फिर दोबारा कोशिश करें।"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का नया संस्करण पहले से इंस्टॉल है। पुराना संस्करण इंस्टॉल करने की सलाह नहीं दी जाती। यदि आप पुराना संस्करण चाहते हैं, तो पहले वर्तमान संस्करण अनइंस्टॉल करें। कोई कार्रवाई चुनें और अगला पर क्लिक करें।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का $R4 संस्करण इंस्टॉल है। आगे बढ़ने से पहले इसे अनइंस्टॉल करने की सलाह दी जाती है। कोई कार्रवाई चुनें और अगला पर क्लिक करें।"
LangString silentDowngrades ${LANG_HINDI} "साइलेंट इंस्टॉलेशन में पुराना संस्करण इंस्टॉल करना अक्षम है। इंस्टॉलर के ग्राफ़िकल इंटरफ़ेस का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल नहीं किया जा सका।"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका। इसके बिना ऐप नहीं चल सकता। इंस्टॉलर फिर से शुरू करें।"
LangString webview2DownloadError ${LANG_HINDI} "WebView2 डाउनलोड करने में त्रुटि: $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 इंस्टॉलर डाउनलोड हो गया।"
LangString webview2Downloading ${LANG_HINDI} "WebView2 इंस्टॉलर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "WebView2 इंस्टॉलेशन त्रुटि कोड $1 के साथ विफल हुआ।"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 इंस्टॉल हो गया।"
LangString deleteAppData ${LANG_HINDI} "ऐप का डेटा हटाएँ"
