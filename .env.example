# Copy to .env for local release builds. Never add a VITE_ prefix to signing settings.
# Keep the private key outside this repository. Use forward slashes in Windows paths.
# Omit this setting to use %USERPROFILE%/.chatgpt-account-switcher/keys/updater.key.
# TAURI_SIGNING_PRIVATE_KEY="C:/Users/YOUR_USER/.chatgpt-account-switcher/keys/updater.key"
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
# GitHub publication uses gh auth login and your OS credential store; no GitHub token belongs here.
